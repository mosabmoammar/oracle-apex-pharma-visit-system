# --- Credentials and connection details -------------------------------------
# Nothing that authenticates anything belongs in version control.
*.env
.env*
config.local.*
wallet/
tnsnames.ora
sqlnet.ora
ords_params/
ords/conf/
*credentials*
*secret*

# --- APEX ------------------------------------------------------------------
# Unsplit exports: a single 40,000-line file no reviewer can read and every
# export re-writes in full. Commit apex/f100/ (split) instead.
f*.sql
!apex/f100/install.sql
apex_export_*.zip

# Workspace and instance exports contain user accounts
w*.sql
instance_*.sql

# --- SQLcl / SQL Developer --------------------------------------------------
.sqlcl/
sqlcl-history.log
*.jdb
.dbtools/

# --- Database artefacts -----------------------------------------------------
*.dmp
*.dpdmp
*.log
*.trc
*.aud
!docs/**/*.log

# --- Real data --------------------------------------------------------------
# The only dataset in this repository is generated by db/seed/09_seed_data.sql
data/real/
*_production_*.sql
*_prod.csv
export_*.csv

# --- Editors and OS ---------------------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# --- Build / scratch --------------------------------------------------------
tmp/
scratch/
*.bak
